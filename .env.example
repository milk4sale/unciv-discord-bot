# Copy to .env and fill in. Get the token from https://discord.com/developers/applications -> your app -> Bot.
DISCORD_TOKEN=

# Where games are saved (default: ./data)
# CIVBOT_DATA=/path/to/data

# --- Optional Activity add-on (see README) ---
# ACTIVITY_PORT=8787
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
